FROM elixir:1.13.4-otp-25

RUN mix local.hex --force
RUN mix local.rebar --force
RUN mix archive.install hex phx_new

COPY . .

# Set exposed ports
EXPOSE 5000

ENV HOST_URL=$host
ENV PORT=5000 MIX_ENV=prod

RUN ./build.sh

RUN chmod +x run.sh
CMD ["DATABASE_URL=/db/db.sqlite3", "./run.sh", "start"]
