<table class="table">
	<thead>
		<tr>
			<%= for column_name <- 
				["ПІБ", "Телефон", "Пошта", "Зареєстровано на дату","Створено запис", " "] 
			do %>
				<th><%= column_name %></th>
			<% end %>
		</tr>
	</thead>
	<tbody>
			<%= for entry <- @table_data do %>
			<tr>
				<th>
					<%= entry.agent_name %>
				</th>
				<th>
					<%= entry.agent_phone %>
				</th>
				<th>
					<%= entry.misc %>
				</th>
				<th>
					<%= entry.booking_date %>
				</th>
				<th>
					<%= entry.inserted_at %>
				</th>
				<th>
					<button class="button is-danger">Видалити</button>
				</th>
			</tr>
			<% end %>
	</tbody>
</table>