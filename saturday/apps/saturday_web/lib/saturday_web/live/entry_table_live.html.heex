<div>
  <table class="table">
    <thead>
      <tr>
        <%= for column_name <- 
				["ПІБ", "Телефон", "Пошта", "Зареєстровано на дату","Створено запис", " "] 
			do %>
          <th><%= column_name %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <%= for entry <- Enum.reverse(@table_data) do %>
        <tr>
          <th>
            <%= entry.agent_name %>
          </th>
          <th>
            <%= entry.agent_phone %>
          </th>
          <th>
            <%= entry.misc %>
          </th>
          <th>
            <%= entry.booking_date %>
          </th>
          <th>
            <%= entry.inserted_at %>
          </th>
          <th>
            <button 
						class="button is-danger"
						phx-click="delete_entry"
						phx-value-id={entry.id}
					>Видалити</button>
          </th>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="container">
    <nav class="pagination" role="pagination" aria-label="pagination">
      <a href="" class="pagination-previous">Previous</a>
      <a href="" class="pagination-next">Next</a>
      <ul class="pagination-list">
        <%= for i <- 1..3 do %>
          <li><span 
					phx-click="change-page"
					phx-value-id={i}
					class={"pagination-link " <> (if @paginate_options.page == i, do: "is-current", else: "")}><%= i %></span></li>
        <% end %>
      </ul>
    </nav>
  </div>
</div>
