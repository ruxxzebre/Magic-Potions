<div>
  <form 
    phx-submit="search-bar"
    phx-change="search-bar"
    phx-debounce="200"
    class="mb-3"
  >
    <div class="select">
      <select value={@query.find_by} 
        class="is-inline" 
        name="search_item">
        <option>Обрати тип</option>
        <%= for {item, [label: label, string: _]} <- @table_columns do %>
          <option 
            {[selected: (@query.find_by == item)]}
            value={item}
            >
            <%= label %>
            </option>
        <% end %>
      </select>
    </div>
    <input 
      class="input is-primary is-inline" 
      type={cond do
        @query.find_by == :booking_date -> "date"
        @query.find_by == :inserted_at -> "date"
        true -> "text"
      end}
      placeholder="Пошук..."
      phx-debounce="300"
      name="search_q"
      value={@query.search_q}
    >
  </form>
  <%= if length(@table_data) > 0 do %>
    <table class="table">
      <thead>
        <tr>
          <%= for {_, [label: column_name, string: _]} <- @table_columns do %>
            <th><%= column_name %></th>
          <% end %>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <%= #TODO: order list by date in ecto query %>
        <%= for entry <- Enum.reverse(@table_data) do %>
          <tr>
            <th>
              <%= entry.agent_name %>
            </th>
            <th>
              <%= entry.agent_phone %>
            </th>
            <th>
              <%= entry.misc %>
            </th>
            <th>
              <%= entry.booking_date %>
            </th>
            <th>
              <%= entry.inserted_at %>
            </th>
            <th>
              <button 
						class="button is-danger"
						phx-click="delete_entry"
						phx-value-id={entry.id}
					>Видалити</button>
            </th>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
  <div class="container">
    <nav class="pagination" role="pagination" aria-label="pagination">
      <a href="" class="pagination-previous">Previous</a>
      <a href="" class="pagination-next">Next</a>
      <ul class="pagination-list">
        <%= for i <- 1..trunc(@entry_amount/@paginate_options.per_page + 1) do %>
          <li><span 
					phx-click="change-page"
					phx-value-page={i}
					class={"pagination-link " <> (if @paginate_options.page == i, do: "is-current", else: "")}><%= i %></span></li>
        <% end %>
      </ul>
    </nav>
  </div>
</div>
