<h1 class="is-size-2">Log in</h1>
<.form let={f} for={@conn} action={Routes.user_session_path(@conn, :create)} as={:user}>
  <%= if @error_message do %>
    <div class="alert alert-danger">
      <p><%= @error_message %></p>
    </div>
  <% end %>
  <div class="field">
    <p class="control">
      <%= label f, :email, class: "label" %>
      <%= email_input f, :email, required: true, class: "input is-primary" %>
    </p>
  </div>
  <div class="field">
    <p class="control">
      <%= label f, :password, class: "label" %>
      <%= password_input f, :password, required: true, class: "input is-primary" %>
    </p>
  </div>
  <div class="field">
    <p class="control">
      <%= label f, :remember_me, "Keep me logged in for 60 days", class: "checkbox" %>
      <%= checkbox f, :remember_me, class: "checkbox" %>
    </p>
  </div>
  <div>
    <%= submit "Log in", class: "button is-primary" %>
  </div>
</.form>
<p>
  <%= # link "Register", to: Routes.user_registration_path(@conn, :new) %>
  <%= # link "Forgot your password?", to: Routes.user_reset_password_path(@conn, :new) %>
</p>
