<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="csrf-token" content={csrf_token_value()}>
    <%= live_title_tag assigns[:page_title] || "Електронна черга", suffix: " · EQUEUE" %>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/assets/app.css")}/>
    <script defer phx-track-static type="text/javascript" src={Routes.static_path(@conn, "/assets/app.js")}></script>
    <%# <a href="https://phoenixframework.org/" class="phx-logo"> %>
  </head>
  <body>
    <div>
      <nav class="navbar has-background-primary-light">
        <div class="navbar-brand">
          <a href="https://www.donnu.edu.ua/uk/" class="image is-96x96 m-2">
            <img src={Routes.static_path(@conn, "/images/logo.png")} alt="DonNU Logo"/>
          </a>
        </div>
        <div class="navbar-menu">
          <%= if @current_user do %>
            <h1 hidden="true" class="navbar-item"><%= # dgettext("management", "management-panel") %></h1>
            <div class="navbar-end">
              <div class="navbar-item">
                <div class="buttons">
                  <%= if @conn.path_info do %>
                    <%= if List.first(@conn.path_info) == "booking" do %>
                      <a 
                        href={"/management"}
                        class="button is-warning"><%= dgettext("management", "open-management-panel") %>
                      </a>
                    <% else %>
                      <a 
                        href={"/booking"}
                        class="button is-warning"><%= dgettext("management", "open-booking-page") %>
                      </a>
                    <% end %>
                  <% end %>
                  <a href="/management/download_report" class="button is-primary"><%= dgettext("management", "download-report") %></a>
                  <a href="/dashboard/home" class="button is-info"><%= dgettext("management", "dashboard") %></a>
                  <a href="/users/log_out" class="button is-danger"><%= dgettext("management", "logout") %></a>
                </div>
              </div>
            </div>
          <% else %>
          <div class="navbar-end">
            <div class="navbar-item">Привіт!</div>
          </div>
          <% end %>
          <div class="navbar-2">
            <%= if function_exported?(Routes, :live_dashboard_path, 2) do %>
              <div class="navbar-item">
                <%= # link "LiveDashboard", to: Routes.live_dashboard_path(@conn, :home) %>
              </div>
            <% end %>
          </div>
        </div>
        <%= # render "_user_menu.html", assigns %>
      </nav>
    </div>
    <%= @inner_content %>
    <footer class="footer">
      Powered by DonNU member
    </footer>
  </body>
</html>
